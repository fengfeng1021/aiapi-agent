load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "codex-moa",
    srcs = ["src/lib.rs"],
    edition = "2021",
    deps = [
        "@crates//:schemars",
        "@crates//:serde",
