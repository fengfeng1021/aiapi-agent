{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aiapi Agent",
  "version": "0.1.0",
  "identifier": "com.aiapi.agent.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src http://127.0.0.1:* ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Aiapi",
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Aiapi Agent - Autonomous Intelligence Workstation",
    "longDescription": "Aiapi Agent - Professional Autonomous Intelligence Workstation with Liquid Glass interface and multi-model agent orchestration.",
    "resources": [
      "runtime.tar.gz",
      "runtime.tar.gz.sha256"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "allowDowngrades": false,
      "wix": {
        "upgradeCode": "3f992021-df3d-5157-93f7-f1aa21de57e7",
        "bannerPath": "wix/banner.bmp",
        "dialogImagePath": "wix/dialog.bmp",
        "language": {
          "en-US": {
            "localePath": "wix/en-US.wxl"
          },
          "zh-CN": {
            "localePath": "wix/zh-CN.wxl"
          }
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.5"
    }
  }
}
